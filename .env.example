# Copy to .env and fill in. Used by docker-compose.yml and by the backend when run locally.

# ---- Database (Docker) ----
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=stockpilot

# ---- Database (running the backend outside Docker) ----
# DATABASE_URL=postgresql+psycopg2://stockpilot:PASSWORD@localhost:5432/stockpilot
# Hosted Postgres with a connection pooler (e.g. Neon): point this at the
# DIRECT (non-pooled) endpoint; LISTEN/NOTIFY does not work through poolers.
# DIRECT_DATABASE_URL=

# ---- Security ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ENV=production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true

# First admin, created/promoted on startup. Remove the password after first login if you like.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Browser origins allowed to call the API directly (the Docker web app is same-origin).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- AI (Ollama) ----
AI_ENABLED=true
# In Docker with `--profile ai`: http://ollama:11434
# Ollama installed on the host instead: http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
# Small models that support tool calling: qwen2.5:3b (default, ~2 GB), llama3.2:3b, qwen2.5:7b (better, ~5 GB)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180

# ---- Ports ----
WEB_PORT=8080
API_PORT=8000
SIMULATOR_PORT=8501

# ---- Backups (the `backup` service writes to ./backups) ----
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# Skip a backup instead of filling the disk when less than this is free
BACKUP_MIN_FREE_MB=2048

# ---- Password reset ----
# Public URL of the web app (reset links point here)
APP_BASE_URL=http://localhost:8080
PASSWORD_RESET_TTL_MINUTES=30
# Optional email for "forgot password". Without it, admins create reset links on Users & Roles.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com,
# SMTP_PASSWORD=<16-char app password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---- Public hosting (docker-compose.prod.yml, see docs/DEPLOYMENT.md) ----
# DOMAIN=stockpilot.yourcompany.com
# ACME_EMAIL=you@yourcompany.com
